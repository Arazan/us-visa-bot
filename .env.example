# US Visa Bot Configuration
# Copy this file to .env and fill in your actual values

# Your credentials for https://ais.usvisa-info.com/
EMAIL=your.email@example.com
PASSWORD=your_password_here

# Country code - found in the URL (e.g. https://ais.usvisa-info.com/en-{COUNTRY_CODE}/...)
# Examples: 'fr' (France), 'br' (Brazil), 'mx' (Mexico)
COUNTRY_CODE=mx

# Schedule ID - found in the URL when trying to reschedule manually
# URL format: https://ais.usvisa-info.com/en-{COUNTRY_CODE}/niv/schedule/{SCHEDULE_ID}/continue_actions
SCHEDULE_ID=12345678

# Facility ID - found in network calls when selecting a new date or inspecting the selector
# Examples: Paris is 44
# URL format: https://ais.usvisa-info.com/{LOCALE}/niv/schedule/{SCHEDULE_ID}/appointment/address/{FACILITY_ID}
FACILITY_ID=44

# Randomized polling delay (seconds). A new value is picked each iteration.
# Optional, defaults to 60/120. MAX must be >= MIN.
REFRESH_DELAY_MIN=60
REFRESH_DELAY_MAX=120

# Optional: mirror booking/error log messages to a Discord channel via webhook.
#DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# --- Run parameters (previously CLI flags) ---

# Your current booked interview date (YYYY-MM-DD) — REQUIRED.
CURRENT_DATE=2026-12-09

# Optional: exit successfully once an appointment <= this date is booked.
#TARGET_DATE=2026-08-01

# Optional: ignore any available date earlier than this.
#MIN_DATE=2026-05-01

# Set to true/1/yes/on to only log what would be booked without actually booking.
# Recommended for first runs.
DRY_RUN=false

# Optional: stop after this many polling iterations (positive integer).
# If unset, the bot polls forever until stopped or a target/booking limit is reached.
#MAX_LOOPS=10

# Optional: stop after this many real bookings (positive integer).
# Dry-run bookings do NOT count. If unset, the bot keeps booking earlier dates indefinitely.
#MAX_BOOKINGS=1
